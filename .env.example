# Copy to .env.local for local development. The NEXT_PUBLIC_ values are PUBLIC (they end up in the
# browser); the inquiry form's secret keys live only in the Cloudflare Worker — see
# docs/inquiries.md.

# URL of the deployed inquiry Worker, e.g. https://bishnoi-inquiry.<your-subdomain>.workers.dev
NEXT_PUBLIC_INQUIRY_ENDPOINT=

# Cloudflare Turnstile SITE key (not the secret). Blank = no "Verify you are human" widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# News feed on the Articles page — see docs/news-feed.md. SECRET: read only by
# scripts/sync-news.mjs at build time. Never give it a NEXT_PUBLIC_ prefix, which would publish it.
NEWS_API_KEY=
# newsdata (default) | gnews | newsapi
NEWS_API_PROVIDER=newsdata
