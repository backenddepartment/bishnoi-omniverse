# Copy to .env.local for local development. Both values are PUBLIC (they end up in the browser);
# the secret keys live only in the Cloudflare Worker — see docs/inquiries.md.

# URL of the deployed inquiry Worker, e.g. https://bishnoi-inquiry.<your-subdomain>.workers.dev
NEXT_PUBLIC_INQUIRY_ENDPOINT=

# Cloudflare Turnstile SITE key (not the secret). Blank = no "Verify you are human" widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
