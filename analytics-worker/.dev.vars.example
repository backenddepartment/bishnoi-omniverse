# Copy to .dev.vars for `npm run dev` (git ignores .dev.vars). Production values are set with
# `npx wrangler secret put <NAME>` instead.
ADMIN_PASSWORD=change-me-to-something-long
# 32+ random characters, e.g. the output of: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=
